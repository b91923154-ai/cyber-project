# REQUIRED for the deep tier. Generate: openssl rand -hex 32
# Must be identical across all server instances (it derives ownership tokens).
CS_VERIFY_SECRET=

# Salt for pseudonymising client IPs in audit logs. Generate: openssl rand -hex 16
CS_LOG_SALT=

# Optional: comma-separated extra domains that can never be scanned (matches subdomains)
CS_DENYLIST=

# Optional: set to "true" to require ownership proof for the basic tier too
CS_REQUIRE_VERIFY_BASIC=false
